{
  "name": "invoice-app",
  "private": true,
  "version": "1.1.0",
  "description": "Helferlein – lokale Rechnungen und geprüfte E-Rechnungsexporte",
  "author": "Mika",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:3000 && node scripts/run-electron.mjs .\"",
    "electron:build": "npm run build:app && node scripts/build-electron.mjs",
    "electron:build:win": "npm run build:app && node scripts/build-electron.mjs --win",
    "electron:build:mac": "npm run build:app && node scripts/build-electron.mjs --mac",
    "electron:build:linux": "npm run build:app && node scripts/build-electron.mjs --linux",
    "export": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/runtime/*.test.cjs tests/einvoice/*.test.cjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "einvoice:prepare": "node scripts/einvoice-prepare.mjs",
    "build:app": "next build && node scripts/prepare-electron-standalone.mjs"
  },
  "build": {
    "appId": "com.invoiceapp.desktop",
    "productName": "Helferlein",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "package.json",
      "!electron/einvoice-runtime/**/*",
      "!electron/einvoice-assets/**/*",
      "!node_modules/next/**/*",
      "!node_modules/@next/**/*",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*",
      "!node_modules/lucide-react/**/*",
      "!node_modules/@radix-ui/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/einvoice-runtime",
        "to": "einvoice-runtime"
      },
      {
        "from": "electron/einvoice-assets",
        "to": "einvoice-assets"
      }
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.business",
      "minimumSystemVersion": "12.0.0",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Helferlein öffnet auf Wunsch eine neue E-Mail mit der Rechnung als Anlage in Apple Mail."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "Helferlein-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-store": "11.0.2",
    "lucide-react": "0.562.0",
    "next": "16.4.3",
    "pdfkit": "0.20.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.13.11",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.23",
    "concurrently": "9.2.5",
    "electron": "43.8.3",
    "electron-builder": "26.18.0",
    "eslint": "9.36.0",
    "eslint-config-next": "16.2.6",
    "png-to-ico": "3.0.1",
    "postcss": "8.5.32",
    "tailwindcss": "4.1.18",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.2",
    "wait-on": "9.0.3"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
